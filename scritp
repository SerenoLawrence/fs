        local serverTime = WS:GetServerTimeNow()
        for name, endTime in pairs(WeatherServiceClient.Events) do
            local raw = string.lower(string.gsub(tostring(name), "[%s%p]", ""))
            if (raw == "volcano" or raw == "volcanoevent") and endTime > serverTime then
                return true
            end
        end
    end
    return false
end

local function MatchesFilter(filterList, value)
    if type(filterList) == "string" then filterList = {filterList} end
    if not filterList or #filterList == 0 then return true end
    if table.find(filterList, "Any") or table.find(filterList, "All") then return true end
    return table.find(filterList, value) ~= nil
end


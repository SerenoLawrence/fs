local function ParseNumber(val)
    if type(val) == "number" then return val end
    local s = tostring(val):gsub("[,%s%$]", "")
    local num, suf = s:match("^([%d%.]+)(%a*)$")
    if not num then return tonumber(s) or 0 end
    local n = tonumber(num) or 0
    local suffixes = {K=3,M=6,B=9,T=12,Q=15,Qi=18,S=21,Sp=24,O=27,N=30,D=33}
    if suf and suf ~= "" and suffixes[suf] then
        return n * (10 ^ suffixes[suf])
    end
    return n
end

local function GetMyPlot()
    local ok, PlotService = pcall(function()
        return require(RS.Modules.ServicesLoader.ClientPlotService)
    end)
    if ok and PlotService and PlotService.Model then return PlotService.Model end
    local plots = WS:FindFirstChild("Plots")
    if plots then
        for _, plot in ipairs(plots:GetChildren()) do
            local owner = plot:GetAttribute("Owner")
            if owner == LP.Name or owner == LP.DisplayName then
                return plot
            end
        end
    end
    return nil
end

local function GetMutation(petModel)
    for _, child in ipairs(petModel:GetChildren()) do
        if DB.MutationOptions and table.find(DB.MutationOptions, child.Name)
            and child.Name ~= "None" and child.Name ~= "Any" then
            return child.Name
        end
    end
    return "None"
end

local function IsVolcanoActive()

-- Auto Kick loop
task.spawn(function()
    while task.wait(0.05) do
        if not _E.HubRunning then break end
        if not _E.AFarm then continue end
        pcall(function()
            local char = LP.Character
            if not char or not char:FindFirstChild("Humanoid") then return end
            char.Humanoid.MaxSlopeAngle = 0
            if KkEvt then
                local power = (_E.CustomKickPowerPercent or 100) / 100
                KkEvt:FireServer(power)
            end
        end)
    end
end)

-- Auto Predict loop
-- Checks every 0.3s (not too fast). Fires kick when ball is within 35 studs.
-- 35 studs gives enough reaction time to look natural.
task.spawn(function()
    while task.wait(0.3) do
        if not _E.HubRunning then break end
        if not _E.APredict then continue end
        pcall(function()
            local char = LP.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local ball = WS:FindFirstChild("Ball") or WS:FindFirstChildWhichIsA("BasePart")
            if ball then
                local dist = (ball.Position - char.HumanoidRootPart.Position).Magnitude
                -- 35 studs: close enough to kick, far enough to look human
                if dist < 35 and KkEvt then
                    -- Small random delay before firing (0.05 - 0.15s) to avoid pattern detection
                    task.wait(math.random(5, 15) / 100)
                    KkEvt:FireServer((_E.CustomKickPowerPercent or 100) / 100)
                end
            end
        end)
    end
end)


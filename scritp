TabUpgrade:CreateButton({
    Name     = "▶️ Start Upgrade Now",
    Callback = function()
        if not Remotes.Upgrade then
            Notify("Error", "Upgrade remote not found!", 3)
            return
        end
        local myPlot = GetMyPlot()
        if not myPlot then
            Notify("Error", "Plot not found!", 3)
            return
        end
        task.spawn(function()
            local targetSlots = {}
            if myPlot:FindFirstChild("Slots") then
                for _, slot in ipairs(myPlot.Slots:GetChildren()) do
                    local placed = slot:FindFirstChild("PlacedPart")
                    if placed then
                        for _, pet in ipairs(placed:GetChildren()) do
                            if pet:IsA("Model") and not pet.Name:match("Hitbox") then
                                local mut = GetMutation(pet)
                                local display = string.format("%s [%s]", pet.Name, mut)
                                local match = false
                                if type(Settings.upgradeTarget) == "table" then
                                    match = table.find(Settings.upgradeTarget, "Any")
                                        or table.find(Settings.upgradeTarget, display)
                                end
                                if match then
                                    local num = tonumber(slot.Name:match("%d+"))
                                    if num then table.insert(targetSlots, num) end
                                end
                            end
                        end
                    end
                end
            end
            for i = 1, Settings.upgradeTimes do
                for _, sNum in ipairs(targetSlots) do
                    pcall(function() Remotes.Upgrade:FireServer(sNum) end)
                    task.wait(0.1)
                end
                task.wait(0.2)
            end
            Notify("Upgrade", "Done! Upgraded " .. #targetSlots .. " slots x" .. Settings.upgradeTimes, 3)
        end)
    end,
})


-- Volcano shard collection loop
-- Scans every 1.5s, moves at a moderate speed (55 studs/s), waits 0.4s before collecting.
-- Fast enough to be useful, slow enough to not look like a teleport hack.
local CollectedShards = {}
task.spawn(function()
    while task.wait(_E.VolcanoCollectDelay or 1.5) do
        if not _E.HubRunning then break end
        if not _E.AVolcanoMaster and not _E.AVolcanoCollect then continue end
        if not IsVolcanoEventActive() then continue end
        pcall(function()
            local char = LP.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            local shardsFolder = WS:FindFirstChild("Shards")
                or WS:FindFirstChild("Orbs")
                or WS:FindFirstChild("VolcanoShards")
            if not shardsFolder then return end
            local nearest, nearestDist = nil, math.huge
            for _, shard in ipairs(shardsFolder:GetChildren()) do
                if shard:IsA("BasePart") and not CollectedShards[shard] then
                    local dist = (shard.Position - hrp.Position).Magnitude
                    if dist < (_E.VolcanoCollectRange or 100) and dist < nearestDist then
                        nearest     = shard
                        nearestDist = dist
                    end
                end
            end
            if nearest then
                CollectedShards[nearest] = true
                nearest.AncestryChanged:Connect(function()
                    CollectedShards[nearest] = nil
                end)
                -- Move toward shard at a moderate speed (not instant teleport)
                -- VolcanoTweenSpeed default is 55 studs/s — feels natural
                _E.VolcanoTweenSpeed = _E.VolcanoTweenSpeed or 55
                smoothMoveTarget = nearest.Position
                -- Wait for movement to reach the shard before collecting
                -- (0.4s base + small random offset so timing varies each time)
                task.wait(0.4 + math.random(5, 15) / 100)
                if SInteractEvt then SInteractEvt:FireServer("CollectShard", nearest) end
            end
        end)
    end
end)


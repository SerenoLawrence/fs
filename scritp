-- ============================================================
-- SMOOTH MOVEMENT (Volcano Shard Collection)
-- ============================================================

local smoothMoveConn = nil
local smoothMoveTarget = nil

local function StartSmoothMovement()
    if smoothMoveConn then return end
    smoothMoveConn = RunService.Heartbeat:Connect(function()
        if not smoothMoveTarget then return end
        pcall(function()
            local char = LP.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            local dist = (hrp.Position - smoothMoveTarget).Magnitude
            if dist < 3 then
                smoothMoveTarget = nil
                return
            end
            local dir = (smoothMoveTarget - hrp.Position).Unit
            local speed = AntiDetect.humanize(Settings.volcanoTweenSpeed, 5)
            hrp.CFrame = hrp.CFrame + dir * (speed * 0.016)
        end)
    end)
end

local function StopSmoothMovement()
    if smoothMoveConn then
        smoothMoveConn:Disconnect()
        smoothMoveConn = nil
    end
    smoothMoveTarget = nil
end

local function TweenToPosition(position, speed)
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    speed = AntiDetect.humanize(speed or Settings.volcanoTweenSpeed, 3)
    local hrp = LP.Character.HumanoidRootPart
    local dist = (hrp.Position - position).Magnitude
    local duration = dist / speed

    -- Noclip during tween
    local noclipConn = RunService.Stepped:Connect(function()
        if LP.Character then
            for _, p in ipairs(LP.Character:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end)

    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(position)
    })
    tween:Play()
    tween.Completed:Wait()
    noclipConn:Disconnect()

    -- Re-enable collisions
    if LP.Character then
        for _, p in ipairs(LP.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
    end
    return true
end


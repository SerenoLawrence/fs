local smoothMoveConn   = nil
local smoothMoveTarget = nil

local function StartSmoothMovement()
    if smoothMoveConn then return end
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")

    smoothMoveConn = RunService.Heartbeat:Connect(function()
        if not smoothMoveTarget then return end
        local plr = Players.LocalPlayer
        local char = plr and plr.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        local dist = (hrp.Position - smoothMoveTarget).Magnitude
        if dist < 3 then
            smoothMoveTarget = nil
            return
        end

        -- If humanoid isn't already moving toward this target, start MoveTo
        -- (MoveTo is safe to call repeatedly; it will update the destination)
        hum:MoveTo(smoothMoveTarget)
    end)
end

local function StopSmoothMovement()
    if smoothMoveConn then
        smoothMoveConn:Disconnect()
        smoothMoveConn = nil
    end
    smoothMoveTarget = nil
end





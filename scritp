local CollectedShards = {}

task.spawn(function()
    while task.wait(Settings.volcanoCollectDelay) do
        if not Settings.volcanoMaster and not Settings.volcanoAutoCollect then continue end
        if not IsVolcanoActive() then continue end

        pcall(function()
            local shardsFolder = WS:FindFirstChild("Shards")
                or WS:FindFirstChild("Orbs")
                or WS:FindFirstChild("VolcanoShards")
            if not shardsFolder then return end

            local char = LP.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart

            -- Find nearest uncollected shard
            local nearest, nearestDist = nil, math.huge
            for _, shard in ipairs(shardsFolder:GetChildren()) do
                if shard:IsA("BasePart") and not CollectedShards[shard] then
                    local dist = (shard.Position - hrp.Position).Magnitude
                    if dist < Settings.volcanoCollectRange and dist < nearestDist then
                        nearest = shard
                        nearestDist = dist
                    end
                end
            end

            if nearest then
                CollectedShards[nearest] = true
                nearest.AncestryChanged:Connect(function()
                    CollectedShards[nearest] = nil
                end)
                SafeWait(0.05, 0.1)
                TweenToPosition(nearest.Position, Settings.volcanoTweenSpeed)
                -- Trigger collection
                if Remotes.Interact then
                    Remotes.Interact:FireServer("CollectShard", nearest)
                end
            end
        end)
    end
end)


local function InjectFilterOptions(optionList)
    local newList = {"Any"}
    local added = {Any = true, All = true, None = true, ["--"] = true}
    for _, opt in ipairs(optionList or {}) do
        if not added[opt] then
            table.insert(newList, opt)
            added[opt] = true
        end
    end
    return newList
end


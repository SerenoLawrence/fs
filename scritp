local AntiDetect = {
    randomDelay = function(min, max)
        min = min or 0.05
        max = max or 0.2
        return math.random(math.floor(min * 1000), math.floor(max * 1000)) / 1000
    end,
    humanize = function(value, variance)
        variance = variance or 3
        return value + math.random(-variance, variance)
    end,
    safeCall = function(fn, ...)
        local ok, result = pcall(fn, ...)
        return ok, result
    end
}


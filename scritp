-- Auto Favorite scan function (called by toggle and loop)
local function RunFavoriteScan()
    pcall(function()
        local myPlot = GetMyPlot()
        if not myPlot or not myPlot:FindFirstChild("Slots") then return end
        for _, slot in ipairs(myPlot.Slots:GetChildren()) do
            local placed = slot:FindFirstChild("PlacedPart")
            if placed then
                for _, pet in ipairs(placed:GetChildren()) do
                    if pet:IsA("Model") and not pet.Name:match("Hitbox") then
                        local mut  = GetMutation(pet)
                        local name = pet.Name
                        local matchBrainrot = (not _E.TSSellBrainrot or #_E.TSSellBrainrot == 0
                            or table.find(_E.TSSellBrainrot, "Any")
                            or table.find(_E.TSSellBrainrot, name))
                        local matchMutation = (not _E.TSSellMutation or #_E.TSSellMutation == 0
                            or table.find(_E.TSSellMutation, "Any")
                            or table.find(_E.TSSellMutation, mut))
                        if matchBrainrot and matchMutation and ToggleFavEvt then
                            ToggleFavEvt:FireServer(pet)
                            task.wait(0.1)
                        end
                    end
                end
            end
        end
    end)
end


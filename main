    _E.TSSellRarity        = {"Any"}
    _E.TSSellMutation      = {"Any"}
    _E.AVolcanoCollect     = false
    _E.AVolcanoUpgrade     = false
    _E.TVolcanoUpgrade     = "Any"
    _E.AVolcanoBuy         = false
